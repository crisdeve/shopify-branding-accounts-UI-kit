# Dominio .myshopify.com de la tienda (sin https://)
SHOPIFY_STORE_DOMAIN=mi-tienda.myshopify.com

# Token del Admin API (shpat_...) de la app instalada en la tienda.
# Scopes necesarios:
#   read_checkout_and_accounts_configurations, write_checkout_and_accounts_configurations
#   (o read_checkout_settings / write_checkout_settings)
#   read_files, write_files
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Versión del Admin API
SHOPIFY_API_VERSION=2026-10
